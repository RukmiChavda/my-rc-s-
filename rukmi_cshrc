#############################################################################
# ~/.cshrc  (tcsh)
# Converted from a bash VLSI-flow .bashrc.
#
# NOTE ON APPROACH:
# tcsh has no real functions/local vars/if-then-else *inside* a single
# alias definition the way bash does. For the handful of bash "functions"
# below that need real logic (optional args, loops, case statements), the
# tcsh alias just shells out to bash with the original logic embedded,
# e.g.:
#     alias foo 'bash -c '"'"'...bash code using "$@"...'"'"' foo \!*'
# This keeps behavior identical to the bash version instead of a lossy
# re-implementation in pure csh syntax. Pure aliases are used everywhere
# a straight one-liner suffices.
#############################################################################

# ---------------------------------------------------------------------------
# 0. Guard clause — only run in interactive shells
# ---------------------------------------------------------------------------
if (! $?prompt) then
    exit
endif

# ---------------------------------------------------------------------------
# 1. History behavior
# ---------------------------------------------------------------------------
set history = 100000
set savehist = (200000 merge)   # merge ~= append-on-exit behavior
set histdup  = erase            # closest match to HISTCONTROL=erasedups
# tcsh has no native "ignorespace" equivalent (space-prefixed cmds still saved)

# ---------------------------------------------------------------------------
# 2. Shell ergonomics
# ---------------------------------------------------------------------------
set autolist                   # tab-complete shows list (checkwinsize-ish QoL)
set implicitcd                 # type a dir name to cd into it (autocd)
set correct = cmd              # autocorrect command typos
set complete = enhance         # case-insensitive / spell-tolerant completion (cdspell/dirspell-ish)
# tcsh globbing does not support bash's globstar (**) recursive glob natively
bindkey -v                     # vi-mode editing (comment out if you prefer emacs)

limit coredumpsize unlimited   # allow core dumps for tool debugging

# ---------------------------------------------------------------------------
# 3. Prompt — host, cwd, git branch, background job count
#    tcsh's "precmd" alias runs before each prompt is drawn, so we rebuild
#    $prompt there (equivalent to bash's PROMPT_COMMAND).
# ---------------------------------------------------------------------------
alias parse_git_branch 'git branch >& /dev/null && git branch | sed -n "/^\*/s/^\* //p"'

alias precmd '\
    set _gitbr = "`parse_git_branch`" ; \
    set prompt = "%{\033[38;5;39m%}%n%{\033[0m%}@%{\033[38;5;208m%}%m%{\033[0m%}:%{\033[38;5;35m%}%~%{\033[0m%}" ; \
    if ("$_gitbr" != "") set prompt = "${prompt}%{\033[38;5;214m%} (${_gitbr})%{\033[0m%}" ; \
    set prompt = "${prompt}%{\033[38;5;244m%}[j:%j]%{\033[0m%} \$ " \
'

# ---------------------------------------------------------------------------
# 4. Environment / paths — EDIT THESE PATHS FOR YOUR SITE
# ---------------------------------------------------------------------------
setenv EDA_ROOT   "/proj/eda"                     # central NFS EDA area
setenv RUNS_ROOT   "${EDA_ROOT}/runs/${USER}"     # per-user run output root
setenv SCRATCH     "/scratch/${USER}"             # fast local scratch
setenv EDITOR      "vim"
setenv PAGER       "less"
setenv LESS        "-R -M -i -j5"                 # nicer less: colors, line#, search context

mkdir -p "$SCRATCH" >& /dev/null

# Lmod / environment modules (uncomment / adjust to your site's module system)
# setenv MODULEPATH "${EDA_ROOT}/modulefiles:${MODULEPATH}"
# source /usr/share/lmod/lmod/init/tcsh

# License servers — adjust to your actual LM_LICENSE_FILE entries
# setenv LM_LICENSE_FILE "27000@license-server1:27000@license-server2"
# setenv SNPSLMD_LICENSE_FILE "$LM_LICENSE_FILE"

# ---------------------------------------------------------------------------
# 5. Navigation helpers — jump straight into block/flow/tag run dirs
#    Expected layout: $RUNS_ROOT/<block>/<flow>/<tag>/
# ---------------------------------------------------------------------------
alias cdrun 'bash -c '"'"'\
    block="$1"; flow="$2"; tag="$3"; \
    path="$RUNS_ROOT/$block"; \
    [ -n "$flow" ] && path="$path/$flow"; \
    [ -n "$tag" ]  && path="$path/$tag"; \
    if [ -d "$path" ]; then echo "$path"; else echo "No such run path: $path" >&2; exit 1; fi \
    '"'"' cdrun \!* | (set _d = "`cat`" ; if ($status == 0) cd "$_d")'

alias cdlatest 'bash -c '"'"'\
    base="$RUNS_ROOT/$1/$2"; \
    latest=$(ls -1dt "$base"/*/ 2>/dev/null | head -1); \
    if [ -n "$latest" ]; then echo "$latest"; else echo "No run tags found under $base" >&2; exit 1; fi \
    '"'"' cdlatest \!* | (set _d = "`cat`" ; if ($status == 0) then; cd "$_d"; echo "-> $_d"; endif)'

alias runs    'cd "$RUNS_ROOT"'
alias scratch 'cd "$SCRATCH"'

# ---------------------------------------------------------------------------
# 6. Log & report inspection shortcuts (STA/PnR flows)
# ---------------------------------------------------------------------------
alias errs 'grep -inE "error|fatal" *.log'
alias warns 'grep -inE "warn" *.log'
alias vio 'grep -inE "violat" *.log *.rpt'

# tail -f a log with error/warn highlighting
alias tailf 'bash -c '"'"'tail -f "$1" | grep --color=always -iE "error|fatal|warn|$"'"'"' tailf \!*'

# quick timing summary grep (WNS/TNS/NVP-style keywords, tool-agnostic)
alias timingsum 'grep -inE "wns|tns|nvp|worst negative slack|total negative slack"'

# quick DRC/violation count from a report
alias viocount 'grep -icE "violat"'

# ---------------------------------------------------------------------------
# 7. Job scheduler helpers (LSF / SGE / SLURM) — uncomment what your site uses
# ---------------------------------------------------------------------------
# --- LSF ---
alias bj  'bjobs -w'
alias bjm 'bjobs -w -u all'
alias bpk 'bpeek'
alias bkillmine 'bash -c '"'"'bjobs -o "JOBID" -noheader | xargs -r bkill'"'"' bkillmine'

# --- SGE ---
# alias qj  'qstat -u $USER'
# alias qjm 'qstat -u "*"'

# --- SLURM ---
# alias sj  'squeue -u $USER'
# alias sjm 'squeue'
# alias scancelmine 'scancel -u $USER'

# generic job watcher — refreshes every 5s
alias watchjobs 'watch -n 5 "bjobs -w >& /dev/null || qstat -u $USER >& /dev/null || squeue -u $USER"'

# ---------------------------------------------------------------------------
# 8. TCL / EDA tool shortcuts
# ---------------------------------------------------------------------------
alias tcls 'tclsh'
alias vims 'vim -c "syntax on" -c "set ft=tcl"'   # open a file with TCL syntax highlighting forced

# strip tool license/banner noise from an interactive log, keep content
alias cleanlog "sed -e '/^#.*License/d' -e '/^Loading/d'"

# find all SDC/UPF/DEF/LEF files under cwd quickly
alias findsdc 'find . -iname "*.sdc"'
alias findupf 'find . -iname "*.upf"'
alias finddef 'find . -iname "*.def*"'
alias findlef 'find . -iname "*.lef*"'

# ---------------------------------------------------------------------------
# 9. Git shortcuts (flow scripts / config repos)
# ---------------------------------------------------------------------------
alias gs  'git status'
alias gd  'git diff'
alias gl  'git log --oneline --graph --decorate -20'
alias ga  'git add'
alias gc  'git commit -m'
alias gp  'git push'
alias gco 'git checkout'

# ---------------------------------------------------------------------------
# 10. General QoL aliases
# ---------------------------------------------------------------------------
alias ll   'ls -alFh --color=auto'
alias la   'ls -A --color=auto'
alias l    'ls -CF --color=auto'
alias grep 'grep --color=auto'
alias ..   'cd ..'
alias ...  'cd ../..'
alias .... 'cd ../../..'
alias df   'df -h'
alias du   'du -h'
alias free 'free -h'
alias path 'echo $PATH:q | tr ":" "\n"'
alias reload 'source ~/.cshrc && echo "cshrc reloaded"'
alias now  'date "+%Y-%m-%d %H:%M:%S"'

# du of run directories sorted by size, top offenders first
alias dusort 'bash -c '"'"'du -h --max-depth=1 "${1:-.}" 2>/dev/null | sort -hr'"'"' dusort \!*'

# quick disk-usage check on NFS project area (adjust path)
alias projspace 'df -h "$EDA_ROOT"'

# create-and-enter directory
alias mkcd 'bash -c '"'"'mkdir -p "$1" && echo "$1"'"'"' mkcd \!* | (set _d = "`cat`" ; if ($status == 0) cd "$_d")'

# extract nearly any archive
alias extract 'bash -c '"'"'\
    f="$1"; \
    if [ -f "$f" ]; then \
        case "$f" in \
            *.tar.bz2) tar xjf "$f" ;; \
            *.tar.gz)  tar xzf "$f" ;; \
            *.tar.xz)  tar xJf "$f" ;; \
            *.bz2)     bunzip2 "$f" ;; \
            *.rar)     unrar x "$f" ;; \
            *.gz)      gunzip "$f" ;; \
            *.tar)     tar xf "$f" ;; \
            *.tbz2)    tar xjf "$f" ;; \
            *.tgz)     tar xzf "$f" ;; \
            *.zip)     unzip "$f" ;; \
            *.7z)      7z x "$f" ;; \
            *)         echo "do not know how to extract $f" ;; \
        esac; \
    else \
        echo "$f is not a valid file"; \
    fi \
    '"'"' extract \!*'

# ---------------------------------------------------------------------------
# 11. Safety nets
# ---------------------------------------------------------------------------
alias rm 'rm -i'
alias cp 'cp -i'
alias mv 'mv -i'

# ---------------------------------------------------------------------------
# 12. Local overrides — keep machine-specific / secret config out of git
# ---------------------------------------------------------------------------
if (-f "$HOME/.cshrc.local") then
    source "$HOME/.cshrc.local"
endif

#############################################################################
# End of .cshrc
#############################################################################
